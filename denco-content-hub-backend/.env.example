# Database (asyncpg for async!)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# App
DEBUG=true
APP_NAME="DENCO Content Hub API"
API_V1_PREFIX=/api/v1

# Database pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Celery (Redis index 1 — broker, index 2 — results)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
